  "$defs": {
    "coreRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "status",
        "proof_required_to_close"
      ],
      "properties": {
        "id": {
          "enum": [
            "contract_identity_authority",
            "exact_input_allowlist",
            "exact_output_allowlist",
            "nested_contract_schema",
            "all_crosswalk_rows_bound",
            "source_traceability",
            "strict_transformation_actions",
            "no_output_enforcement",
            "fixture_refusals",
            "single_decision",
            "review_gates"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "met_for_internal_trial_contract"
        },
        "proof_required_to_close": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findingClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding",
        "classification",
        "blocks",
        "does_not_block",
        "proof_required_to_close"
      ],
      "properties": {
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "core_requirement_met",
            "quality_improvement_available",
            "minor_carry_flag",
            "scale_blocker",
            "core_spec_failure"
          ]
        },
        "blocks": {
          "type": "string",
          "minLength": 1
        },
        "does_not_block": {
          "type": "string",
          "minLength": 1
        },
        "proof_required_to_close": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contractIdentityAuthority": {
      "type": "object",
      "additionalProperties": false,
