        },
        "accepted_planning_decision": {
          "const": "PROCEED_TO_INTERNAL_OVERLAY_TRIAL_CONTRACT_DRAFT"
        },
        "accepted_planning_decision_source": {
          "const": "reports/inspection-standards/internal-overlay-prototype-planning-decision.md"
        },
        "decision_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_source_allowlist_only",
        "implicit_source_discovery",
        "directory_globbing_allowed",
        "generated_lesson_output_scanning",
        "automated_source_refresh"
