        "accepted_planning_decision_source",
        "decision_scope"
      ],
      "properties": {
        "product_end_state": {
          "const": "../4veco-lessen/specifications/product-end-state.md"
        },
        "original_sprint_gate_spec": {
          "const": "archive/sprints/GOAL-IQS-INTERNAL-OVERLAY-TRIAL-CONTRACT-1/GOAL-IQS-INTERNAL-OVERLAY-TRIAL-CONTRACT-1-sprint-plan.md"
        },
        "roadmap_source": {
