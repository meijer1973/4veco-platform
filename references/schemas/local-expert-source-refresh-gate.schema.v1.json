    "non_negotiable_requirements": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {
          "const": "Use REV-STD-1 and cite product end-state plus the original sprint/gate spec."
        },
        {
          "const": "Cite the accepted no-output simulation decision and preserve the no-output/no-runtime/no-product-authority boundary."
        },
        {
          "const": "Define local expert role contract fields without substituting local expert judgement."
        },
        {
          "const": "Define source-refresh protocol fields without executing source refresh."
        },
        {
          "const": "Use explicit source and output allowlists only; no directory globbing or generated lesson-output scanning."
        },
        {
          "const": "Include England and Flanders jurisdiction-specific gates."
        },
        {
          "const": "Simulate source-refresh gate classification cases without refreshing sources or producing localized output."
        },
        {
          "const": "Refuse forbidden audiences, claims, integrations, product routes, Scale Gate, diagnostics/mastery/PV, personal data, support/accommodation sufficiency, and compliance/inspection-readiness claims."
        },
        {
          "const": "Classify findings with blocks, does_not_block, and proof_required_to_close."
        },
        {
          "const": "PASS WITH FLAGS may not carry a missing core requirement."
        }
      ]
    },
