        },
        {
          "const": "references/data/inspection-standards/overlays/england.deepening.v1.json"
        },
        {
          "const": "references/data/inspection-standards/overlays/flanders.deepening.v1.json"
        }
      ],
      "minItems": 7,
      "maxItems": 7
    },
    "output_allowlist": {
      "type": "array",
      "prefixItems": [
        {
          "const": "references/schemas/bounded-source-refresh-packet.schema.v1.json"
