    "forbidden_authority": {
      "$ref": "#/$defs/forbiddenAuthority"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "final_decision_options": {
      "type": "array",
      "prefixItems": [
        {
          "const": "PROCEED_TO_SOURCE_REFRESH_EXECUTION_PILOT"
        },
        {
          "const": "REVISE_SOURCE_REFRESH_PACKET"
        },
        {
          "const": "STOP_LOCAL_OVERLAY_TRACK"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "selected_target_decision": {
      "const": "PROCEED_TO_SOURCE_REFRESH_EXECUTION_PILOT"
    },
    "source_refresh_inventory_summary": {
      "$ref": "#/$defs/sourceRefreshInventorySummary"
    },
    "refresh_state_model": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/refreshState"
      }
    },
    "local_expert_review_request_template": {
      "$ref": "#/$defs/expertTemplate"
    },
