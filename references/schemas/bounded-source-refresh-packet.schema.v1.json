        },
        {
          "const": "references/data/inspection-standards/fixtures/bounded-source-refresh-packet/negative/local-expert-substituted.sample.json"
        },
        {
          "const": "references/data/inspection-standards/fixtures/bounded-source-refresh-packet/negative/localized-output.sample.json"
        },
