      "$ref": "#/$defs/noOutput"
    },
    "jurisdiction_id": {
      "enum": [
        "england",
        "flanders"
      ]
    },
    "jurisdiction_label": {
      "type": "string",
      "minLength": 1
    },
    "source_inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceInventoryItem"
      }
    },
    "jurisdiction_packet_coverage": {
      "$ref": "#/$defs/jurisdictionPacketCoverage"
    },
    "simulation_cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/simulationCase"
      }
    },
