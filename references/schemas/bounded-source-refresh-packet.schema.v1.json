    },
    "accepted_input_decision": {
      "const": "PROCEED_TO_BOUNDED_SOURCE_REFRESH_PACKET"
    },
    "non_negotiable_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "core_requirement_checklist": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/coreRequirement"
      }
    },
    "input_allowlist": {
      "type": "array",
      "prefixItems": [
        {
          "const": "reports/inspection-standards/local-expert-source-refresh-gate-decision.json"
        },
        {
          "const": "reports/inspection-standards/local-expert-source-refresh-gate-plan.json"
        },
        {
          "const": "reports/inspection-standards/england-source-refresh-gate-simulation.json"
