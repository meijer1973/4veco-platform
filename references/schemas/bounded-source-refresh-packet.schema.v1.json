      "type": "object",
      "additionalProperties": false,
      "required": [
        "england_sources",
        "flanders_sources",
        "candidate_sources_allowed",
        "candidate_source_policy",
        "jurisdiction_boundary_notes"
      ],
      "properties": {
        "england_sources": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "flanders_sources": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_sources_allowed": {
          "const": false
        },
        "candidate_source_policy": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction_boundary_notes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "refreshState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "blocks",
        "does_not_block",
        "proof_required_to_close",
        "allowed_next_action",
        "forbidden_next_action"
      ],
      "properties": {
        "state_id": {
          "enum": [
            "unchanged",
            "updated_same_source",
            "replaced_by_official_successor",
            "official_source_unavailable",
            "candidate_gap_found",
            "out_of_scope_source_found",
            "requires_local_expert_interpretation",
            "requires_human_owner_decision"
          ]
        },
        "blocks": {
          "type": "string",
          "minLength": 1
        },
        "does_not_block": {
          "type": "string",
          "minLength": 1
