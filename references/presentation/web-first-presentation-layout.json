{
  "schema_version": 1,
  "policy_id": "web-first-presentation-layout",
  "derived_from": "references/exemplars/1.1.1-golden-presentation/",
  "required_page_affordances": [
    "slide_list_navigation",
    "slide_count_or_progress",
    "keyboard_navigation",
    "notes_toggle",
    "dark_mode",
    "fullscreen_or_presentation_mode_if_available",
    "clear_return_route",
    "semantic_headings",
    "accessible_controls"
  ],
  "required_layout_families": [
    "route_contract_cards",
    "narrative_case_comparison",
    "relation_diagram",
    "transfer_cards",
    "misconception_cards",
    "procedure_steps",
    "worked_example_table",
    "worked_example_interpretation",
    "retrieval_check_card",
    "summary_bridge"
  ],
  "forbidden_assumptions": [
    "pptx_as_design_source",
    "mandatory_powerpoint_download_for_web_first_artifact",
    "teacher_only_notes_by_default",
    "procedure_hidden_only_in_notes"
  ]
}
