      "payload": {
        "data": {
          "parNr": "2.1.1",
          "layout": { "framework": "golden_exercise_workbench" },
          "tasks": [
            {
              "type": "task_shell",
              "taskShell": {
                "id": "graph",
                "family": "graph_construction_substitute",
                "prompt": "Plaats twee punten en kies daarna of de lijn stijgend of dalend is.",
                "interaction": {
                  "pointCount": 2,
                  "lineShapeLabel": "Lijnvorm",
                  "lineShapeOptions": [
                    { "id": "up", "label": "Stijgend" },
                    { "id": "down", "label": "Dalend" }
                  ]
                },
                "expected": {
                  "pointPolicy": "straight_line_two_distinct_table_points"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "answer_giving_placeholder",
      "category": "interaction",
      "expected_violation": "answer_giving_placeholder",
      "description": "A graph-reading or calculation placeholder cannot reveal the expected answer.",
