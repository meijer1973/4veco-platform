                "expected": {
                  "finalAnswer": {
                    "value": 225,
                    "acceptedNotations": ["225"]
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "formula_token_bank_ordered_as_answer",
      "category": "interaction",
      "expected_violation": "formula_tokens_ordered_answer",
      "description": "A formula token bank cannot display the answer sequence from left to right.",
      "payload": {
        "data": {
          "parNr": "2.1.1",
          "layout": { "framework": "golden_exercise_workbench" },
          "tasks": [
            {
              "type": "task_shell",
              "taskShell": {
                "id": "formula",
                "family": "calculation_work_capture",
                "interaction": {
                  "formula": {
                    "tokens": [
                      { "id": "open", "label": "(" },
                      { "id": "new", "label": "nieuwe prijs" },
                      { "id": "minus", "label": "-" },
                      { "id": "old", "label": "oude prijs" },
                      { "id": "close", "label": ")" },
                      { "id": "divide", "label": "/" },
                      { "id": "old", "label": "oude prijs" },
                      { "id": "times100", "label": "x 100%" },
                      { "id": "plus", "label": "+" }
                    ]
                  }
                },
                "expected": {
                  "formula": {
                    "tokens": ["open", "new", "minus", "old", "close", "divide", "old", "times100"]
                  }
                }
              }
            }
          ]
        }
      }
    },
