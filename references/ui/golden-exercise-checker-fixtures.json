        "data": {
          "parNr": "2.1.1",
          "layout": { "framework": "golden_exercise_workbench" },
          "tasks": [
            {
              "type": "task_shell",
              "taskShell": {
                "id": "read",
                "family": "graph_reading",
                "prompt": "Lees de hoeveelheid af.",
                "interaction": {
                  "inputPlaceholder": "vul 225 in"
