{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reasoning Game Golden Exemplar Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "family_id",
    "exemplars"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "family_id": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "exemplars": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "reasoning_family",
          "reasoning_grammar",
          "status",
          "authority",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "paragraph": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning_family": {
            "type": "string"
          },
          "reasoning_grammar": {
            "type": "string"
          },
          "core_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "authority": {
            "type": "object"
          },
          "files": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
