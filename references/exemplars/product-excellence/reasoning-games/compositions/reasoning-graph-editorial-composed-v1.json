                "label": "Vraag",
                "points": [
                  {
                    "id": "p2-q600",
                    "x": 2,
                    "y": 600,
                    "label": "P=2, Q=600",
                    "kind": "answer"
                  },
                  {
                    "id": "p8-q300",
                    "x": 8,
                    "y": 300,
                    "label": "P=8, Q=300",
                    "kind": "answer"
