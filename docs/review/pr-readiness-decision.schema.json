{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meijer1973/4veco-platform/docs/review/pr-readiness-decision.schema.json",
  "title": "4veco PR readiness decision",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "reviewed_pr",
    "throughput",
    "human_review_payload",
    "consequence",
    "batching",
    "route",
    "reason_codes",
    "proof",
    "allowed_transition",
    "human_notification_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_pr": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "repo",
        "number",
        "url",
        "base",
        "head_sha",
        "was_draft"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{40}$"
        },
        "was_draft": {
          "type": "boolean"
        }
      }
    },
    "throughput": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "class",
        "authority_class",
        "level"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "micro_maintenance",
            "normal_sprint",
            "generated_output",
            "high_authority",
            "cross_repo_bundle"
          ]
        },
        "authority_class": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        }
      }
    },
    "human_review_payload": {
      "type": "string",
      "enum": [
        "none",
        "thin",
        "substantial",
        "consequential_exception"
      ]
    },
    "consequence": {
      "type": "string"
    },
    "batching": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "viable",
        "target",
        "reason"
      ],
      "properties": {
        "viable": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "route": {
      "type": "string",
      "enum": [
        "KEEP_DRAFT_REVISE",
        "KEEP_DRAFT_BATCH",
        "READY_FOR_LEAD_ONLY",
        "READY_FOR_HUMAN_REVIEW",
        "PAUSE_ESCALATE"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ci_head_sha",
        "lead_review_path",
        "lead_review_result",
        "lead_reviewed_sha",
        "changed_paths_verified"
      ],
      "properties": {
        "ci_head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "lead_review_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "lead_review_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "lead_reviewed_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "changed_paths_verified": {
          "type": "boolean"
        }
      }
    },
    "allowed_transition": {
      "type": "string",
      "enum": [
        "NONE",
        "MARK_READY"
      ]
    },
    "human_notification_required": {
      "type": "boolean"
    }
  }
}
