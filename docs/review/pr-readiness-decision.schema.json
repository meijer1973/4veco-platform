{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meijer1973/4veco-platform/docs/review/pr-readiness-decision.schema.json",
  "title": "4veco PR readiness decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_pr",
    "throughput",
    "human_review_payload",
    "consequence",
    "batching",
    "route",
    "reason_codes",
    "proof",
    "allowed_transition",
    "human_notification_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "number",
        "url",
        "base",
        "head_sha",
        "was_draft"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{40}$"
        },
        "was_draft": {
          "type": "boolean"
        }
      }
    },
    "throughput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "authority_class",
        "level"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "micro_maintenance",
            "normal_sprint",
            "generated_output",
            "high_authority",
            "cross_repo_bundle"
          ]
        },
        "authority_class": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        }
      }
    },
    "human_review_payload": {
      "type": "string",
      "enum": [
        "none",
        "thin",
        "substantial",
        "consequential_exception"
      ]
    },
    "consequence": {
      "type": "string"
    },
    "batching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viable",
        "target",
        "reason"
      ],
      "properties": {
        "viable": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "route": {
      "type": "string",
      "enum": [
        "KEEP_DRAFT_REVISE",
        "KEEP_DRAFT_BATCH",
        "READY_FOR_LEAD_ONLY",
        "READY_FOR_HUMAN_REVIEW",
        "PAUSE_ESCALATE"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci_head_sha",
        "ci_status",
        "ci_required_contexts",
        "ci_checks",
        "lead_review_path",
        "lead_review_result",
        "lead_reviewed_sha",
        "lead_review_evidence_tail_allowed",
        "changed_paths_verified",
        "checkers"
      ],
      "properties": {
        "ci_head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "ci_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "ci_required_contexts": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "validate-platform"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ci_missing_contexts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ci_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "conclusion"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "conclusion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "lead_review_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "lead_review_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "lead_reviewed_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{40}$"
        },
        "changed_paths_verified": {
          "type": "boolean"
        },
        "lead_review_evidence_tail_allowed": {
          "type": "boolean"
        },
        "lead_review_integration_authorization_inherited": {
          "type": "boolean"
        },
        "lead_review_integration_delta_reviewed": {
          "type": "boolean"
        },
        "post_lead_review_changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "branch_protection": {
          "type": "object",
          "additionalProperties": true
        },
        "bundle_delegated_ci": {
          "type": "boolean"
        },
        "bundle": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "merge_ready": {
              "type": "boolean"
            },
            "transition_ready": {
              "type": "boolean"
            },
            "controller": {
              "type": "object",
              "required": [
                "repository",
                "pr_number",
                "reviewed_payload_head_sha"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "pr_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "reviewed_payload_head_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                }
              },
              "additionalProperties": true
            },
            "exact_members": {
              "type": "object",
              "required": [
                "platform_base_sha",
                "platform_candidate_sha",
                "lesson_base_sha",
                "lesson_candidate_sha"
              ],
              "properties": {
                "platform_base_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "platform_candidate_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "lesson_base_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "lesson_candidate_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                }
              },
              "additionalProperties": false
            },
            "paired_prs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "repository",
                  "pr_number",
                  "base",
                  "open",
                  "current",
                  "mergeable",
                  "ready",
                  "is_draft",
                  "head_sha",
                  "reviewed_payload_head_sha"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pr_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "base": {
                    "type": "string",
                    "minLength": 1
                  },
                  "open": {
                    "type": "boolean"
                  },
                  "current": {
                    "const": true
                  },
                  "mergeable": {
                    "const": true
                  },
                  "ready": {
                    "type": "boolean"
                  },
                  "is_draft": {
                    "type": "boolean"
                  },
                  "head_sha": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{40}$"
                  },
                  "reviewed_payload_head_sha": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{40}$"
                  },
                  "merged": {
                    "type": "boolean"
                  },
                  "merge_commit_sha": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{40}$"
                  }
                },
                "oneOf": [
                  {
                    "properties": {
                      "open": {
                        "const": true
                      },
                      "merged": {
                        "const": false
                      }
                    },
                    "not": {
                      "required": [
                        "merge_commit_sha"
                      ]
                    }
                  },
                  {
                    "required": [
                      "merged",
                      "merge_commit_sha"
                    ],
                    "properties": {
                      "open": {
                        "const": false
                      },
                      "merged": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            },
            "transitionable_draft_members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "repository",
                  "pr_number",
                  "base",
                  "head_sha",
                  "reviewed_payload_head_sha",
                  "reason"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pr_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "base": {
                    "type": "string",
                    "minLength": 1
                  },
                  "head_sha": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{40}$"
                  },
                  "reviewed_payload_head_sha": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{40}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "paired_lead_reviews": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "pr_number",
                  "reviewed_commit_sha",
                  "review_result",
                  "review_path"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pr_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reviewed_commit_sha": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{40}$"
                  },
                  "review_result": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "PASS WITH FLAGS"
                    ]
                  },
                  "review_path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "integration_refresh": {
              "type": "object",
              "required": [
                "status",
                "order",
                "platform_payload_sha",
                "platform_integration_head_sha",
                "lesson_payload_sha",
                "lesson_merge_commit_sha",
                "refresh_result",
                "lineage",
                "readiness",
                "ci"
              ],
              "properties": {
                "status": {
                  "const": "complete"
                },
                "order": {
                  "const": "lesson-first"
                },
                "platform_payload_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "platform_integration_head_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "lesson_payload_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "lesson_merge_commit_sha": {
                  "type": "string",
                  "pattern": "^[A-Fa-f0-9]{40}$"
                },
                "refresh_result": {
                  "type": "object",
                  "required": [
                    "status",
                    "trusted_executor",
                    "platform_integration_head_sha",
                    "previous_platform_head_sha",
                    "lesson_merge_commit_sha",
                    "changed_paths",
                    "verified_paths",
                    "hashes",
                    "metadata",
                    "commit"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "created",
                        "reused"
                      ]
                    },
                    "trusted_executor": {
                      "const": "platform-main"
                    },
                    "platform_integration_head_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "previous_platform_head_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "lesson_merge_commit_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "changed_paths": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "reports/github-agent-index-lessen.json",
                          "reports/github-agent-index-lessen.md",
                          "reports/github-agent-index-platform.json",
                          "reports/github-agent-index-platform.md"
                        ]
                      }
                    },
                    "verified_paths": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "reports/github-agent-index-lessen.json",
                          "reports/github-agent-index-lessen.md",
                          "reports/github-agent-index-platform.json",
                          "reports/github-agent-index-platform.md"
                        ]
                      }
                    },
                    "hashes": {
                      "type": "object",
                      "required": [
                        "reports/github-agent-index-lessen.json",
                        "reports/github-agent-index-lessen.md",
                        "reports/github-agent-index-platform.json",
                        "reports/github-agent-index-platform.md"
                      ],
                      "properties": {
                        "reports/github-agent-index-lessen.json": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{64}$"
                        },
                        "reports/github-agent-index-lessen.md": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{64}$"
                        },
                        "reports/github-agent-index-platform.json": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{64}$"
                        },
                        "reports/github-agent-index-platform.md": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{64}$"
                        }
                      },
                      "additionalProperties": false
                    },
                    "metadata": {
                      "type": "object",
                      "required": [
                        "platform_source_commit",
                        "platform_source_branch",
                        "lesson_source_commit",
                        "lesson_source_branch",
                        "generated_at"
                      ],
                      "properties": {
                        "platform_source_commit": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{40}$"
                        },
                        "platform_source_branch": {
                          "type": "string",
                          "minLength": 1
                        },
                        "lesson_source_commit": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{40}$"
                        },
                        "lesson_source_branch": {
                          "const": "origin/main"
                        },
                        "generated_at": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
                        }
                      },
                      "additionalProperties": false
                    },
                    "commit": {
                      "type": "object",
                      "required": [
                        "sha",
                        "parent_sha",
                        "changed_paths"
                      ],
                      "properties": {
                        "sha": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{40}$"
                        },
                        "parent_sha": {
                          "type": "string",
                          "pattern": "^[A-Fa-f0-9]{40}$"
                        },
                        "changed_paths": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "reports/github-agent-index-lessen.json",
                              "reports/github-agent-index-lessen.md",
                              "reports/github-agent-index-platform.json",
                              "reports/github-agent-index-platform.md"
                            ]
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": true
                },
                "lineage": {
                  "type": "object",
                  "required": [
                    "reviewed_payload_head_sha",
                    "integration_head_sha",
                    "payload_ancestor_of_integration_head",
                    "authorization_inherited",
                    "failures"
                  ],
                  "properties": {
                    "reviewed_payload_head_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "integration_head_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "payload_ancestor_of_integration_head": {
                      "const": true
                    },
                    "authorization_inherited": {
                      "const": true
                    },
                    "failures": {
                      "type": "array",
                      "maxItems": 0
                    }
                  },
                  "additionalProperties": true
                },
                "readiness": {
                  "type": "object",
                  "required": [
                    "head_sha",
                    "route",
                    "attestation_schema_version",
                    "attestation_digest"
                  ],
                  "properties": {
                    "head_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "route": {
                      "enum": [
                        "READY_FOR_LEAD_ONLY",
                        "READY_FOR_HUMAN_REVIEW"
                      ]
                    },
                    "attestation_schema_version": {
                      "const": 2
                    },
                    "attestation_digest": {
                      "type": "string",
                      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
                    }
                  },
                  "additionalProperties": true
                },
                "ci": {
                  "type": "object",
                  "required": [
                    "status",
                    "platform_sha",
                    "lesson_sha"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "success",
                        "succeeded",
                        "passed",
                        "pass",
                        "ok"
                      ]
                    },
                    "platform_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "lesson_sha": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{40}$"
                    },
                    "run_id": {
                      "type": [
                        "integer",
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "human_authorization": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "integration": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "delta_review": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "result",
                "reviewed_payload_head_sha",
                "integration_head_sha",
                "path"
              ],
              "properties": {
                "result": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "PASS WITH FLAGS"
                  ]
                },
                "reviewed_payload_head_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "integration_head_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "allowed_transition": {
      "type": "string",
      "enum": [
        "NONE",
        "MARK_READY"
      ]
    },
    "human_notification_required": {
      "type": "boolean"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_merge": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "proof"
        ],
        "properties": {
          "proof": {
            "required": [
              "lead_review_integration_delta_reviewed"
            ],
            "properties": {
              "lead_review_integration_delta_reviewed": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "required": [
              "integration"
            ],
            "properties": {
              "integration": {
                "type": "object",
                "required": [
                  "ok",
                  "reviewed_payload_head_sha",
                  "integration_head_sha",
                  "authorization_inherited",
                  "requires_human_reauthorization",
                  "base_drift",
                  "delta_review"
                ],
                "properties": {
                  "ok": {
                    "const": true
                  },
                  "authorization_inherited": {
                    "const": true
                  },
                  "requires_human_reauthorization": {
                    "const": false
                  },
                  "base_drift": {
                    "type": "object",
                    "required": [
                      "requires_human_reauthorization"
                    ],
                    "properties": {
                      "requires_human_reauthorization": {
                        "const": false
                      }
                    }
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "requires_integration_delta_lead_review"
                    ],
                    "properties": {
                      "requires_integration_delta_lead_review": {
                        "const": true
                      }
                    }
                  },
                  {
                    "required": [
                      "base_drift"
                    ],
                    "properties": {
                      "base_drift": {
                        "required": [
                          "requires_integration_delta_lead_review"
                        ],
                        "properties": {
                          "requires_integration_delta_lead_review": {
                            "const": true
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "route",
          "proof"
        ],
        "properties": {
          "route": {
            "enum": [
              "READY_FOR_LEAD_ONLY",
              "READY_FOR_HUMAN_REVIEW"
            ]
          },
          "proof": {
            "required": [
              "integration"
            ],
            "properties": {
              "integration": {
                "type": "object",
                "required": [
                  "delta_review"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "required": [
              "lead_review_integration_delta_reviewed"
            ],
            "properties": {
              "lead_review_integration_delta_reviewed": {
                "const": true
              }
            }
