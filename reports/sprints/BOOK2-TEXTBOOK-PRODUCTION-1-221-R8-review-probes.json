    "paragraph": 1,
    "paragraph_title": "Prijselasticiteit",
    "difficulty": "MEDIUM",
    "target_exercise": {
      "context": "Bioscoop Nova verhoogt de ticketprijs van €10 naar €12; de gevraagde hoeveelheid daalt van 500 naar 420 tickets per week. Bij StreamNow is voor een andere prijsverhoging Ev=−2 gemeten. Gebruik voor Nova de oude waarde als noemer en Ev=%ΔQv/%ΔP.",
      "subquestions": [
        {
          "label": "a",
          "points": 3,
          "prompt": "Bereken voor Bioscoop Nova de procentuele prijsverandering, de procentuele verandering van de gevraagde hoeveelheid en Ev."
        },
        {
          "label": "b",
          "points": 2,
          "prompt": "Classificeer de vraag naar bioscoopkaartjes met |Ev| en leg in gewone taal uit wat Ev=−0,8 betekent."
        },
        {
          "label": "c",
          "points": 2,
          "prompt": "Classificeer de vraag naar StreamNow met Ev=−2 en vergelijk de prijsgevoeligheid met die van Bioscoop Nova."
        },
        {
          "label": "d",
          "points": 2,
          "prompt": "Geef één plausibele contextverklaring voor het verschil in prijsgevoeligheid. Baseer je verklaring niet op een andere elasticiteitssoort."
        }
      ]
    },
    "lesson_goals": [
      "Je kunt procentuele prijs- en hoeveelheidsveranderingen met de oude waarde als noemer berekenen.",
      "Je kunt Ev inclusief het teken berekenen.",
      "Je kunt vraag met |Ev| classificeren als prijselastisch of prijsinelastisch.",
      "Je kunt verschillen in prijsgevoeligheid met contextgegevens verklaren zonder verder te gaan dan de gegevens."
    ],
